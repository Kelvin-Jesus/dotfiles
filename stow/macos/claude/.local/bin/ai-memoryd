#!/bin/bash
# ai-memoryd: start/stop the ai-memory server on demand.
#
#   ai-memoryd up|ensure   start the server if it is not running (idempotent, waits until ready)
#   ai-memoryd down        stop the server and its idle watchdog
#   ai-memoryd status      show whether it is running
#   ai-memoryd logs        tail the server log
#
# `up` also starts a tiny watchdog that stops the server once no claude/codex
# process has been running for IDLE_LIMIT consecutive checks, so the server
# only lives while an agent needs it.

BIN="$HOME/Applications/ai-memory/ai-memory"
DATA_DIR="$HOME/Library/Application Support/ai-memory"
BIND_HOST=127.0.0.1
BIND_PORT=49374
STATE_DIR="$HOME/.local/state/ai-memory"
LOG_DIR="$HOME/Library/Logs/ai-memory"
PID_FILE="$STATE_DIR/server.pid"
WATCHDOG_PID_FILE="$STATE_DIR/watchdog.pid"
LOCK_DIR="$STATE_DIR/start.lock"
CHECK_INTERVAL=30
IDLE_LIMIT=4   # 4 x 30s = 2 minutes without any agent

mkdir -p "$STATE_DIR" "$LOG_DIR"

port_open() { nc -z -G 1 "$BIND_HOST" "$BIND_PORT" >/dev/null 2>&1; }

pid_alive() { [ -f "$1" ] && kill -0 "$(cat "$1")" 2>/dev/null; }

# True while a claude or codex CLI (or the app-server behind the desktop app) is running.
agents_running() {
  pgrep -x claude >/dev/null 2>&1 || pgrep -x codex >/dev/null 2>&1
}

start_watchdog() {
  pid_alive "$WATCHDOG_PID_FILE" && return 0
  (
    idle=0
    while pid_alive "$PID_FILE" || port_open; do
      sleep "$CHECK_INTERVAL"
      if agents_running; then idle=0; else idle=$((idle + 1)); fi
      if [ "$idle" -ge "$IDLE_LIMIT" ]; then
        "$0" down --from-watchdog
        exit 0
      fi
    done
    rm -f "$WATCHDOG_PID_FILE"
  ) >/dev/null 2>&1 &
  echo $! > "$WATCHDOG_PID_FILE"
  disown 2>/dev/null || true
}

cmd_up() {
  if port_open; then start_watchdog; return 0; fi

  # Serialize concurrent starts (several sessions open at once): one data dir, one server.
  waited=0
  until mkdir "$LOCK_DIR" 2>/dev/null; do
    if port_open; then start_watchdog; return 0; fi
    # Break a lock left behind by a crashed starter.
    if [ -n "$(find "$LOCK_DIR" -maxdepth 0 -mmin +1 2>/dev/null)" ]; then rmdir "$LOCK_DIR" 2>/dev/null; fi
    sleep 0.2; waited=$((waited + 1))
    [ "$waited" -gt 100 ] && { echo "ai-memoryd: timed out waiting for another start" >&2; return 1; }
  done
  trap 'rmdir "$LOCK_DIR" 2>/dev/null' EXIT

  if ! port_open; then
    nohup "$BIN" --data-dir "$DATA_DIR" serve --transport http --bind "$BIND_HOST:$BIND_PORT" \
      >>"$LOG_DIR/stdout.log" 2>>"$LOG_DIR/stderr.log" </dev/null &
    echo $! > "$PID_FILE"
    disown 2>/dev/null || true
    for _ in $(seq 1 75); do   # up to ~15s (first start after an upgrade runs migrations)
      port_open && break
      kill -0 "$(cat "$PID_FILE")" 2>/dev/null || { echo "ai-memoryd: server exited, see $LOG_DIR/stderr.log" >&2; return 1; }
      sleep 0.2
    done
    port_open || { echo "ai-memoryd: server did not open $BIND_HOST:$BIND_PORT" >&2; return 1; }
  fi
  start_watchdog
}

cmd_down() {
  if pid_alive "$PID_FILE"; then
    pid=$(cat "$PID_FILE")
    kill "$pid" 2>/dev/null
    for _ in $(seq 1 50); do kill -0 "$pid" 2>/dev/null || break; sleep 0.2; done
    kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null
  fi
  rm -f "$PID_FILE"
  # Stop the watchdog unless this call came from it.
  if [ "$1" != "--from-watchdog" ] && pid_alive "$WATCHDOG_PID_FILE"; then
    kill "$(cat "$WATCHDOG_PID_FILE")" 2>/dev/null
  fi
  rm -f "$WATCHDOG_PID_FILE"
}

cmd_status() {
  if port_open; then
    echo "ai-memory: running on $BIND_HOST:$BIND_PORT (pid $(cat "$PID_FILE" 2>/dev/null || echo '?'))"
    pid_alive "$WATCHDOG_PID_FILE" && echo "watchdog: active (stops after $((CHECK_INTERVAL * IDLE_LIMIT))s without claude/codex)"
  else
    echo "ai-memory: stopped"
  fi
}

case "${1:-}" in
  up|ensure) cmd_up ;;
  down|stop) cmd_down "${2:-}" ;;
  status)    cmd_status ;;
  logs)      tail -n 50 -f "$LOG_DIR/stderr.log" "$LOG_DIR/stdout.log" ;;
  *) echo "usage: ai-memoryd {up|ensure|down|status|logs}" >&2; exit 2 ;;
esac
